#!/usr/bin/env bash

build-start() {
  BUILD_ID=$(aws codebuild start-build --project-name "$PROJECT_NAME" \
  --debug-session-enabled --environment-variables-override name=DEBUG,value=1,type=PLAINTEXT \
  --query "build.id" --output text)
  echo "BUILD_ID=$BUILD_ID"
}

wait-for-target() {
  TARGET=None
  local MAX_ATTEMPT=12
  local ATTEMPT=$MAX_ATTEMPT
  while true; do
    echo "$(date -Iseconds) Attempt $((MAX_ATTEMPT - ATTEMPT + 1)) / ${MAX_ATTEMPT} to get target"
    sleep 1
    TARGET=$(aws codebuild batch-get-builds --ids "$BUILD_ID" \
    --query "builds[0].debugSession.sessionTarget" --output text)
    ATTEMPT=$((ATTEMPT - 1))
    if [[ "$TARGET" != "None" || $ATTEMPT -eq 0 ]]; then
      break
    fi
    sleep 12
  done
  echo "TARGET=$TARGET"
  if [[ "$TARGET" == "None" ]]; then
    echo "Failed to get TARGET after $MAX_ATTEMPT attempts"
    return 1
  fi
}

ssm-start() {
  wait-for-target
  echo "resume use command 'sleep 10 && codebuild-resume'"
  aws ssm start-session --target "$TARGET" \
  --document-name AWS-StartInteractiveCommand --parameters command="/usr/bin/tmux"
}

{
  export AWS_REGION=ap-northeast-3
  PROJECT_NAME=stg-app-build
  grep ^[a-z] bin/ssm-start | awk -F'(' '{print "  " $1}'
}
