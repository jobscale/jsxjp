{
  "name": "jsxjp",
  "private": true,
  "version": "0.4.0",
  "description": "nodejs http and vue custom template SSR MVC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jobscale/jsxjp.git"
  },
  "author": "jobscale <jobscale@users.noreply.github.com>",
  "license": "MIT",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "tauri": "(cd tauri-app && npm run tauri dev)",
    "build": "bash -c 'time (cd tauri-app && npm run tauri build)'",
    "check:jest": "NODE_OPTIONS=--experimental-vm-modules jest --runInBand --coverage --collectCoverage --verbose",
    "check:docs": "node scripts/check-docs-pages.js",
    "lint": "eslint",
    "pretest": "date -Iseconds",
    "posttest": "npm run lint",
    "test": "npm run check:jest"
  },
  "pre-commit": [
    "test"
  ],
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1118.0",
    "@aws-sdk/client-ssm": "^3.1118.0",
    "@jobscale/create-logger": "^1.0.0",
    "dayjs": "^1.11.21",
    "http-errors": "^2.0.1",
    "mime": "^4.1.0"
  },
  "devDependencies": {
    "@jobscale/eslint-plugin-standard": "^0.1.2",
    "eslint": "^10.8.0",
    "eslint-plugin-jest": "^29.16.0",
    "jest": "^30.4.2",
    "pre-commit": "^2.0.0",
    "puppeteer": "^25.3.0",
    "supertest": "^7.2.2"
  }
}
