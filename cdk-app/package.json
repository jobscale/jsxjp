{
  "name": "cdk-app",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "watch": "echo \"No watch configured for JavaScript ESM\"",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest --runInBand --coverage --collectCoverage --verbose",
    "lint": "eslint",
    "prelint": "npm config set script-shell bash",
    "predeploy": "npm run lint",
    "predeploy:force": "npm run lint && npm config set script-shell bash",
    "bootstrap": "ENV=${ENV:-dev} && cdk --context env=$ENV bootstrap",
    "validate": "ENV=${ENV:-dev} && cdk --context env=$ENV validate --build --unstable=validate",
    "synth": "ENV=${ENV:-dev} && cdk --context env=$ENV synth",
    "diff": "ENV=${ENV:-dev} && cdk --context env=$ENV diff",
    "deploy": "ENV=${ENV:-dev} && time cdk --context env=$ENV deploy",
    "deploy:force": "ENV=${ENV:-dev} && time cdk --context env=$ENV deploy --require-approval never",
    "ls": "ENV=${ENV:-dev} && cdk --context env=$ENV ls",
    "cdk": "ENV=${ENV:-dev} && cdk --context env=$ENV"
  },
  "dependencies": {
    "@jobscale/create-logger": "^1.0.1",
    "aws-cdk-lib": "^2.263.0",
    "constructs": "^10.8.1"
  },
  "devDependencies": {
    "@jobscale/eslint-plugin-standard": "^0.1.1",
    "aws-cdk": "^2.1138.0",
    "eslint-plugin-jest": "^29.16.0",
    "jest": "^30.4.2"
  }
}
