{
  "name": "cdk-app",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "watch": "echo \"No watch configured for JavaScript ESM\"",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest --runInBand --coverage --collectCoverage --verbose",
    "lint": "eslint",
    "predeploy": "npm run lint",
    "bootstrap": "ENV=${ENV:-dev} && cdk bootstrap --context env=$ENV",
    "validate": "ENV=${ENV:-dev} && cdk validate --build --unstable=validate --context env=$ENV",
    "synth": "ENV=${ENV:-dev} && cdk synth --context env=$ENV",
    "diff": "ENV=${ENV:-dev} && cdk diff --context env=$ENV",
    "deploy": "ENV=${ENV:-dev} && cdk deploy --context env=$ENV",
    "deploy:force": "ENV=${ENV:-dev} && cdk deploy --context env=$ENV --require-approval never",
    "ls": "ENV=${ENV:-dev} && cdk ls --context env=$ENV"
  },
  "dependencies": {
    "@jobscale/create-logger": "^1.0.0",
    "@jobscale/slack": "^0.3.2",
    "@napi-rs/canvas": "^1.0.7",
    "aws-cdk-lib": "^2.263.0",
    "constructs": "^10.8.1",
    "dayjs": "^1.11.23",
    "http-errors": "^2.0.1",
    "joi": "^18.2.3",
    "nodemailer": "^9.0.5",
    "sharp": "^0.35.3",
    "speakeasy": "^2.0.0",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@jobscale/eslint-plugin-standard": "^0.1.1",
    "aws-cdk": "^2.1138.0",
    "eslint-plugin-jest": "^29.16.0",
    "jest": "^30.4.2"
  }
}
